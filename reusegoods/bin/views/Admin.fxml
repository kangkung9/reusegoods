            <Font size="18.0" />
         </font></Label>
      <TextField fx:id="tfNama" layoutX="73.0" layoutY="279.0" prefHeight="25.0" prefWidth="202.0" styleClass="textfield" stylesheets="@../loginDesign.css" />
      <TextField fx:id="tfHarga" layoutX="74.0" layoutY="316.0" prefHeight="25.0" prefWidth="200.0" styleClass="textfield" stylesheets="@../loginDesign.css" />
      <Button layoutX="290.0" layoutY="316.0" mnemonicParsing="false" onAction="#handleButtonAction" prefHeight="25.0" prefWidth="73.0" styleClass="textfield" stylesheets="@../loginDesign.css" text="Tambah" />
      <Button layoutX="291.0" layoutY="353.0" mnemonicParsing="false" onAction="#ButtonHapusData" prefHeight="25.0" prefWidth="57.0" styleClass="textfield" stylesheets="@../loginDesign.css" text="Hapus" />
