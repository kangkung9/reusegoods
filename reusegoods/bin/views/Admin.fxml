      <TextArea fx:id="tfDeskripsi" layoutX="74.0" layoutY="350.0" prefHeight="65.0" prefWidth="200.0" styleClass="textfield" stylesheets="@../loginDesign.css" />
      <Label layoutX="22.0" layoutY="283.0" text="Nama" />
      <Label layoutX="22.0" layoutY="320.0" text="Harga" />
      <Label layoutX="14.0" layoutY="357.0" text="Deskripsi" />
